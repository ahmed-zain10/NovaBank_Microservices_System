// ============================================================
// NovaBank — Pipeline 1: Full Deploy (من الصفر) — EKS Edition
// ============================================================
//
// ✅ مبني على مراجعة فعلية لملفات k8s/ الحقيقية بتاعتك. الهيكل هو:
//
//   k8s/
//     api-gateway/            (Deployment + Service + Ingress)
//     auth-service/           (Deployment + Service)
//     accounts-service/       (Deployment + Service)
//     transactions-service/   (Deployment + Service)
//     notifications-service/  (Deployment + Service)
//     frontend-customers/     (Deployment + Service + Ingress)
//     frontend-teller/        (Deployment + Service + Ingress)
//
// اسم الفولدر = اسم الـ service (وده اللي بيتستخدم في `k8s apply`)
// namespace: بيتحدد جوه كل YAML نفسه ومطابق لهذا الجدول:
//   api-gateway -> api-gateway | auth-service -> auth
//   accounts-service -> accounts | transactions-service -> transactions
//   notifications-service -> notifications
//   frontend-customers -> frontend-customers | frontend-teller -> frontend-teller
//
// ⚠️ الملفات فيها placeholders (${AWS_ACCOUNT_ID}, ${AWS_REGION}, ${IMAGE_TAG},
// ${CUSTOMER_DOMAIN}, ${TELLER_DOMAIN}) — بيتم حقنها بـ envsubst قبل kubectl apply.
//
// ⚠️ لازم تتأكد إن الـ secrets (novabank/dev/rds/<schema>) فيها مفتاح "host"
// (RDS endpoint) جوه الـ JSON، لأن الـ Deployments مبتمررش RDS host كـ env var
// منفصل — الكود المفروض يجيبه من جوه السيكريت نفسه.
// ============================================================
pipeline {
    agent any

    options {
        timeout(time: 90, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    environment {
        AWS_REGION      = 'us-east-1'
        AWS_ACCOUNT_ID  = '816709079108'
        ENV             = 'dev'
        PROJECT         = 'novabank'
        REGISTRY        = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
        TF_DIR          = 'terraform/envs/dev'
        CLUSTER         = 'novabank-dev'   // ← اسم الـ EKS cluster (مش ECS)

        // لازم تطابق terraform.tfvars بتاعة dev — مستخدمة في الـ Ingress hosts (envsubst)
        CUSTOMER_DOMAIN = 'app-dev.novabank-eg.com'
        TELLER_DOMAIN   = 'teller-dev.novabank-eg.com'
    }

    parameters {
        string(name: 'IMAGE_TAG', defaultValue: 'v1.0.0', description: 'Docker image tag')
    }

    stages {

        // ── 1. Install Dependencies ────────────────────────────
        stage('Install Dependencies') {
            steps {
                sh '''
                    echo "=== Checking dependencies ==="

                    # AWS CLI
                    if command -v aws &>/dev/null; then
                        echo "AWS CLI already installed: $(aws --version)"
                    else
                        echo "Installing AWS CLI..."
                        sudo rm -rf /tmp/aws /tmp/awscliv2.zip
                        curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/awscliv2.zip
                        unzip -q /tmp/awscliv2.zip -d /tmp
                        sudo /tmp/aws/install --update
                        sudo rm -rf /tmp/aws /tmp/awscliv2.zip
                        echo "AWS CLI installed: $(aws --version)"
                    fi

                    # Terraform
                    if command -v terraform &>/dev/null; then
                        echo "Terraform already installed: $(terraform version -json | python3 -c 'import sys,json; print(json.load(sys.stdin)["terraform_version"])')"
                    else
                        echo "Installing Terraform..."
                        curl -fsSL "https://releases.hashicorp.com/terraform/1.7.5/terraform_1.7.5_linux_amd64.zip" \
                            -o /tmp/terraform.zip
                        sudo unzip -q /tmp/terraform.zip -d /usr/local/bin
                        sudo chmod +x /usr/local/bin/terraform
                        rm -f /tmp/terraform.zip
                        echo "Terraform installed"
                    fi
                    terraform --version

                    # kubectl
                    if command -v kubectl &>/dev/null; then
                        echo "kubectl already installed: $(kubectl version --client -o json | python3 -c 'import sys,json; print(json.load(sys.stdin)[\"clientVersion\"][\"gitVersion\"])')"
                    else
                        echo "Installing kubectl..."
                        KVER=$(curl -fsSL https://dl.k8s.io/release/stable.txt)
                        curl -fsSL "https://dl.k8s.io/release/${KVER}/bin/linux/amd64/kubectl" -o /tmp/kubectl
                        sudo install -o root -g root -m 0755 /tmp/kubectl /usr/local/bin/kubectl
                        rm -f /tmp/kubectl
                        echo "kubectl installed: $(kubectl version --client --short 2>/dev/null || kubectl version --client)"
                    fi

                    # Helm (مطلوب لو محتاج تعمل helm upgrade يدوي على ALB controller / autoscaler لاحقًا)
                    if command -v helm &>/dev/null; then
                        echo "Helm already installed: $(helm version --short)"
                    else
                        echo "Installing Helm..."
                        curl -fsSL https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3 -o /tmp/get_helm.sh
                        chmod +x /tmp/get_helm.sh
                        sudo /tmp/get_helm.sh
                        rm -f /tmp/get_helm.sh
                        echo "Helm installed"
                    fi

                    # Docker
                    if command -v docker &>/dev/null; then
                        echo "Docker already installed: $(docker --version)"
                    else
                        echo "❌ Docker not found — ده لازم يكون مثبت على الـ Jenkins server"
                        exit 1
                    fi

                    # envsubst (مطلوب لحقن AWS_ACCOUNT_ID/AWS_REGION/IMAGE_TAG/CUSTOMER_DOMAIN/TELLER_DOMAIN
                    # جوه ملفات k8s/*/*.yaml قبل kubectl apply)
                    if command -v envsubst &>/dev/null; then
                        echo "envsubst already installed"
                    else
                        echo "Installing gettext-base (envsubst)..."
                        sudo apt-get update -qq
                        sudo apt-get install -y -qq gettext-base
                        echo "envsubst installed"
                    fi

                    echo "✅ All dependencies ready"
                '''
            }
        }

        // ── 2. Checkout ────────────────────────────────────────
        stage('Checkout') {
            steps {
                checkout scm
                sh 'echo "✅ Code checked out: $(git log --oneline -1)"'
            }
        }

        // ── 3. Bootstrap Terraform State ───────────────────────
        stage('Bootstrap State') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-creds']
                ]) {
                    sh '''
                        echo "=== Bootstrapping Terraform State ==="
                        cd terraform/scripts
                        chmod +x bootstrap_state.sh
                        BUCKET="novabank-terraform-state-dev"
                        if aws s3api head-bucket --bucket "$BUCKET" --region ${AWS_REGION} 2>/dev/null; then
                            echo "✅ State bucket already exists — skipping bootstrap"
                        else
                            ./bootstrap_state.sh dev ${AWS_REGION}
                            echo "✅ Bootstrap complete"
                        fi
                    '''
                }
            }
        }

        // ── 4. Build Lambda Zip ────────────────────────────────
        stage('Build Lambda') {
            steps {
                sh '''
                    echo "=== Building Lambda Zip ==="
                    cd terraform/modules/rds
                    chmod +x build_lambda.sh
                    ./build_lambda.sh
                    echo "✅ Lambda zip built"
                '''
            }
        }

        // ── 5. Terraform Init ──────────────────────────────────
        stage('Terraform Init') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-creds'],
                    file(credentialsId: 'terraform-tfvars-dev', variable: 'TFVARS_FILE')
                ]) {
                    sh '''
                        echo "=== Terraform Init ==="
                        cd ${TF_DIR}

                        # انسخ الـ tfvars من Jenkins Credentials
                        rm -f terraform.tfvars && cp "$TFVARS_FILE" terraform.tfvars

                        mkdir -p $HOME/.terraform.d/plugin-cache
                        export TF_PLUGIN_CACHE_DIR="$HOME/.terraform.d/plugin-cache"

                        terraform init -reconfigure
                        echo "✅ Terraform initialized"
                    '''
                }
            }
        }

        // ── 6. Import Existing Secrets ─────────────────────────
        stage('Import Secrets') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-creds'],
                    file(credentialsId: 'terraform-tfvars-dev', variable: 'TFVARS_FILE')
                ]) {
                    sh '''
                        echo "=== Import existing secrets (if any) ==="
                        cd ${TF_DIR}

                        rm -f terraform.tfvars && cp "$TFVARS_FILE" terraform.tfvars

                        # دالة تعمل import لو الـ secret موجود على AWS
                        # لو موجود في الـ state خلاص بتتجاهله بسبب || true
                        tf_import_if_exists() {
                            TF_ADDR="$1"
                            AWS_SECRET_ID="$2"
                            if aws secretsmanager describe-secret \
                                --secret-id "$AWS_SECRET_ID" \
                                --region ${AWS_REGION} \
                                --output text --query "Name" 2>/dev/null | grep -q "."; then
                                echo "  → Importing: $AWS_SECRET_ID"
                                terraform import \
                                    -var-file=terraform.tfvars \
                                    -var="image_tag=${IMAGE_TAG}" \
                                    "$TF_ADDR" "$AWS_SECRET_ID" 2>&1 || true
                            else
                                echo "  → Not found on AWS, will create: $AWS_SECRET_ID"
                            fi
                        }

                        tf_import_if_exists "module.secrets.aws_secretsmanager_secret.rds_master"                    "novabank/dev/rds/master"
                        tf_import_if_exists 'module.secrets.aws_secretsmanager_secret.schema_creds["transactions"]'  "novabank/dev/rds/transactions"
                        tf_import_if_exists 'module.secrets.aws_secretsmanager_secret.schema_creds["auth"]'          "novabank/dev/rds/auth"
                        tf_import_if_exists 'module.secrets.aws_secretsmanager_secret.schema_creds["notifications"]' "novabank/dev/rds/notifications"
                        tf_import_if_exists 'module.secrets.aws_secretsmanager_secret.schema_creds["accounts"]'      "novabank/dev/rds/accounts"
                        tf_import_if_exists "module.secrets.aws_secretsmanager_secret.jwt"                           "novabank/dev/jwt-secret"

                        echo "✅ Import done"
                    '''
                }
            }
        }

        // ── 7. Terraform Plan ──────────────────────────────────
        stage('Terraform Plan') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-creds'],
                    file(credentialsId: 'terraform-tfvars-dev', variable: 'TFVARS_FILE')
                ]) {
                    sh '''
                        echo "=== Terraform Plan ==="
                        cd ${TF_DIR}
                        rm -f terraform.tfvars && cp "$TFVARS_FILE" terraform.tfvars

                        terraform plan \
                            -var-file=terraform.tfvars \
                            -var="image_tag=${IMAGE_TAG}" \
                            -out=tfplan
                        echo "✅ Plan complete"
                    '''
                }
            }
        }

        // ── 8. Terraform Apply ─────────────────────────────────
        stage('Terraform Apply') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-creds']
                ]) {
                    sh '''
                        echo "=== Terraform Apply ==="
                        cd ${TF_DIR}
                        terraform apply -auto-approve tfplan
                        echo "✅ Infrastructure deployed (VPC, EKS, RDS, ECR, IAM, addons, helm controllers...)"
                    '''
                }
            }
        }

        // ── 9. Update kubeconfig ───────────────────────────────
        stage('Update kubeconfig') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-creds']
                ]) {
                    sh '''
                        echo "=== Pointing kubectl at the EKS cluster ==="
                        aws eks update-kubeconfig --name ${CLUSTER} --region ${AWS_REGION}
                        kubectl get nodes
                        echo "✅ kubeconfig updated"
                    '''
                }
            }
        }

        // ── 10. Fix Secret DBNames ──────────────────────────────
        stage('Fix Secret DBNames') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-creds']
                ]) {
                    sh '''
                        echo "=== Fixing dbname/host/port in secrets ==="

                        RDS_HOST=$(aws rds describe-db-instances \
                            --db-instance-identifier novabank-${ENV}-rds \
                            --region ${AWS_REGION} \
                            --query 'DBInstances[0].Endpoint.Address' \
                            --output text)
                        echo "RDS Host: ${RDS_HOST}"

                        cat > /tmp/fix_secrets.py << SCRIPTEOF
import json, subprocess, re

schemas = ['auth', 'accounts', 'transactions', 'notifications']
region  = '${AWS_REGION}'
env     = '${ENV}'
rds_host = '${RDS_HOST}'

for schema in schemas:
    secret_id = f'novabank/{env}/rds/{schema}'

    r = subprocess.run(
        ['aws', 'secretsmanager', 'get-secret-value',
         '--secret-id', secret_id,
         '--region', region,
         '--query', 'SecretString',
         '--output', 'text'],
        capture_output=True, text=True, check=True
    )

    raw = r.stdout.strip()

    try:
        current = json.loads(raw)
    except json.JSONDecodeError:
        current = {}
        for match in re.finditer(r'([a-zA-Z0-9_]+):([^,}]+)', raw):
            current[match.group(1)] = match.group(2).strip()

    current['dbname'] = 'novabank'
    current['schema'] = schema
    current['host']   = rds_host
    current['port']   = 5432
    new_val = json.dumps(current)

    subprocess.run(
        ['aws', 'secretsmanager', 'update-secret',
         '--secret-id', secret_id,
         '--region', region,
         '--secret-string', new_val,
         '--query', 'Name',
         '--output', 'text'],
        capture_output=True, text=True, check=True
    )
    print(f'  Fixed: {secret_id} (host={rds_host})')

print('All secrets fixed')
SCRIPTEOF

                        python3 /tmp/fix_secrets.py
                        echo "✅ Secrets fixed"
                    '''
                }
            }
        }

        // ── 11. Deploy Lambda ───────────────────────────────────
        stage('Deploy Lambda') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-creds']
                ]) {
                    sh '''
                        echo "=== Uploading Lambda Zip to AWS ==="
                        ZIP_PATH="terraform/modules/rds/db_init_lambda.zip"

                        if [ ! -f "$ZIP_PATH" ]; then
                            echo "❌ Lambda zip not found at $ZIP_PATH"
                            exit 1
                        fi

                        aws lambda wait function-active \
                            --function-name novabank-${ENV}-db-init \
                            --region ${AWS_REGION}

                        aws lambda update-function-code \
                            --function-name novabank-${ENV}-db-init \
                            --zip-file fileb://$ZIP_PATH \
                            --region ${AWS_REGION} \
                            --query 'FunctionArn' \
                            --output text

                        aws lambda wait function-updated \
                            --function-name novabank-${ENV}-db-init \
                            --region ${AWS_REGION}

                        echo "✅ Lambda deployed successfully"
                    '''
                }
            }
        }

        // ── 12. ECR Login ───────────────────────────────────────
        stage('ECR Login') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-creds']
                ]) {
                    sh '''
                        echo "=== Logging in to ECR ==="
                        aws ecr get-login-password --region ${AWS_REGION} | \
                            docker login --username AWS --password-stdin ${REGISTRY}
                        echo "✅ ECR login successful"
                    '''
                }
            }
        }

        // ── 13. Build & Push Docker Images ─────────────────────
        stage('Build & Push Images') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-creds']
                ]) {
                    sh '''
                        echo "=== Building and pushing images ==="
                        chmod +x terraform/scripts/push_images.sh
                        ./terraform/scripts/push_images.sh \
                            ${ENV} ${AWS_REGION} ${AWS_ACCOUNT_ID} ${IMAGE_TAG}
                        echo "✅ All images pushed"
                    '''
                }
            }
        }

        // ── 14. Init Database ──────────────────────────────────
        stage('Init Database') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-creds']
                ]) {
                    sh '''
                        echo "=== Initializing Database ==="

                        aws lambda wait function-active \
                            --function-name novabank-dev-db-init \
                            --region ${AWS_REGION}

                        rm -f /tmp/db-result.json
                        aws lambda invoke \
                            --function-name novabank-dev-db-init \
                            --region ${AWS_REGION} \
                            --cli-read-timeout 300 --cli-connect-timeout 300 \
                            /tmp/db-result.json

                        cat /tmp/db-result.json

                        STATUS=$(python3 -c "import json; d=json.load(open('/tmp/db-result.json')); print(d.get('statusCode',500))")
                        if [ "$STATUS" != "200" ]; then
                            echo "❌ DB init failed!"
                            exit 1
                        fi
                        echo "✅ Database initialized"
                    '''
                }
            }
        }

        // ── 15. Deploy K8s Manifests (namespaces/Deployments/Services/Ingress) ──
        stage('Deploy K8s Manifests') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-creds']
                ]) {
                    sh '''#!/bin/bash
                        set -e
                        echo "=== Applying Kubernetes manifests ==="
                        aws eks update-kubeconfig --name ${CLUSTER} --region ${AWS_REGION}

                        echo "=== Diagnostic: AWS Load Balancer Controller status ==="
                        kubectl get pods -n kube-system -l app.kubernetes.io/name=aws-load-balancer-controller -o wide || true
                        kubectl get svc -n kube-system aws-load-balancer-webhook-service || true
                        kubectl describe pod -n kube-system -l app.kubernetes.io/name=aws-load-balancer-controller || true
                        echo "--- controller logs (last 100 lines) ---"
                        kubectl logs -n kube-system -l app.kubernetes.io/name=aws-load-balancer-controller --tail=100 || true
                        echo "=== End diagnostic ==="

                        # اسم الفولدر جوه k8s/ = اسم الـ service بالظبط (مش اسم الـ namespace)
                        # namespace: بتحدده YAML نفسه (metadata.namespace) — matched بالفعل مع
                        # الجدول: auth-service->auth, accounts-service->accounts, ...
                        SERVICES="api-gateway auth-service accounts-service transactions-service notifications-service frontend-customers frontend-teller"

                        if [ ! -d "k8s" ]; then
                            echo "⚠️  فولدر k8s/ مش موجود في الريبو — الخطوة دي هتتخطى."
                            exit 0
                        fi

                        export AWS_ACCOUNT_ID AWS_REGION CUSTOMER_DOMAIN TELLER_DOMAIN
                        export IMAGE_TAG="${IMAGE_TAG}"

                        RENDERED_DIR="/tmp/k8s-rendered-${BUILD_NUMBER}"
                        rm -rf "$RENDERED_DIR" && mkdir -p "$RENDERED_DIR"

                        for svc in $SERVICES; do
                            if [ -d "k8s/${svc}" ]; then
                                mkdir -p "${RENDERED_DIR}/${svc}"
                                for f in k8s/${svc}/*.yaml; do
                                    envsubst < "$f" > "${RENDERED_DIR}/${svc}/$(basename "$f")"
                                done
                                kubectl apply -f "${RENDERED_DIR}/${svc}/"
                                echo "  ✔ applied manifests for: ${svc}"
                            else
                                echo "  ⚠ k8s/${svc} not found — skipping"
                            fi
                        done

                        rm -rf "$RENDERED_DIR"
                        echo "✅ Manifests applied"
                    '''
                }
            }
        }

        // ── 15b. Enable CloudFront (wire ALB DNS -> module.cloudfront) ──
        // The ALB is created dynamically by the AWS Load Balancer Controller
        // once the Ingress objects above exist — it doesn't exist at
        // `Terraform Apply` time, so modules/cloudfront was skipped there
        // (count = 0, see main.tf). Now that the Ingress exists, fetch the
        // real ALB DNS name and run a second, targeted apply to turn the
        // CloudFront distributions on.
        stage('Enable CloudFront') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-creds'],
                    file(credentialsId: 'terraform-tfvars-dev', variable: 'TFVARS_FILE')
                ]) {
                    sh '''#!/bin/bash
                        echo "=== Waiting for the shared ALB to be provisioned ==="
                        aws eks update-kubeconfig --name ${CLUSTER} --region ${AWS_REGION}

                        ALB_DNS=""
                        for i in $(seq 1 30); do
                            ALB_DNS=$(kubectl get ingress -n api-gateway api-gateway-ingress \
                                -o jsonpath='{.status.loadBalancer.ingress[0].hostname}' 2>/dev/null || true)
                            if [ -n "$ALB_DNS" ]; then
                                echo "  ALB DNS found: ${ALB_DNS}"
                                break
                            fi
                            echo "  waiting for ALB Controller to provision the ALB... (${i}/30, ~5min max)"
                            sleep 10
                        done

                        if [ -z "$ALB_DNS" ]; then
                            echo "❌ ALB DNS not available after 5 minutes."
                            echo "   CloudFront will stay disabled this run — check:"
                            echo "     kubectl describe ingress -n api-gateway api-gateway-ingress"
                            echo "     kubectl logs -n kube-system deploy/aws-load-balancer-controller"
                            exit 1
                        fi

                        echo "=== Enabling CloudFront with ALB origin: ${ALB_DNS} ==="
                        cd ${TF_DIR}
                        rm -f terraform.tfvars && cp "$TFVARS_FILE" terraform.tfvars

                        terraform apply \
                            -var-file=terraform.tfvars \
                            -var="image_tag=${IMAGE_TAG}" \
                            -var="alb_origin_domain=${ALB_DNS}" \
                            -target=module.cloudfront \
                            -auto-approve

                        echo "✅ CloudFront enabled"
                    '''
                }
            }
        }

        // ── 16. Deploy Application Images to EKS ────────────────
        stage('Deploy Application to EKS') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-creds']
                ]) {
                    sh '''#!/bin/bash
                        echo "=== Rolling out application images to EKS ==="
                        aws eks update-kubeconfig --name ${CLUSTER} --region ${AWS_REGION}

                        declare -A NS_MAP=(
                          [api-gateway]=api-gateway
                          [auth-service]=auth
                          [accounts-service]=accounts
                          [transactions-service]=transactions
                          [notifications-service]=notifications
                          [frontend-customers]=frontend-customers
                          [frontend-teller]=frontend-teller
                        )

                        for svc in "${!NS_MAP[@]}"; do
                            ns="${NS_MAP[$svc]}"
                            image="${REGISTRY}/novabank/${ENV}/${svc}:${IMAGE_TAG}"

                            if kubectl get deployment "${svc}" -n "${ns}" &>/dev/null; then
                                kubectl set image deployment/"${svc}" "${svc}=${image}" -n "${ns}" --record=true
                                echo "  ↻ ${svc} (ns: ${ns}) -> ${IMAGE_TAG}"
                            else
                                echo "  ⚠ deployment/${svc} not found in namespace ${ns} — تأكد إن k8s manifests اتعملها apply قبل كده"
                            fi
                        done

                        echo "✅ All services updated"
                    '''
                }
            }
        }

        // ── 17. Health Check ────────────────────────────────────
        stage('Health Check') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-creds']
                ]) {
                    sh '''#!/bin/bash
                        echo "=== Waiting for rollouts to complete ==="
                        aws eks update-kubeconfig --name ${CLUSTER} --region ${AWS_REGION}

                        declare -A NS_MAP=(
                          [api-gateway]=api-gateway
                          [auth-service]=auth
                          [accounts-service]=accounts
                          [transactions-service]=transactions
                          [notifications-service]=notifications
                          [frontend-customers]=frontend-customers
                          [frontend-teller]=frontend-teller
                        )

                        ALL_HEALTHY=true
                        for svc in "${!NS_MAP[@]}"; do
                            ns="${NS_MAP[$svc]}"
                            if ! kubectl get deployment "${svc}" -n "${ns}" &>/dev/null; then
                                echo "  ⚠ ${svc}: deployment not found in ${ns} — skipping health check"
                                continue
                            fi
                            if kubectl rollout status deployment/"${svc}" -n "${ns}" --timeout=180s; then
                                echo "  ✅ ${svc}: healthy"
                            else
                                echo "  ❌ ${svc}: rollout failed/timed out"
                                ALL_HEALTHY=false
                            fi
                        done

                        if [ "$ALL_HEALTHY" = "false" ]; then
                            echo "❌ Some services are not healthy!"
                            exit 1
                        fi

                        echo "✅ All services healthy!"

                        CUSTOMER_URL="https://app-dev.novabank-eg.com"
                        TELLER_URL="https://teller-dev.novabank-eg.com"
                        CUST_STATUS=$(curl -s -o /dev/null -w "%{http_code}" ${CUSTOMER_URL}/health || echo "000")
                        echo "Customer Portal status: ${CUST_STATUS}"

                        echo "🚀 Deploy complete!"
                        echo "   Customer: ${CUSTOMER_URL}"
                        echo "   Teller:   ${TELLER_URL}"
                    '''
                }
            }
        }
    }

    post {
        always {
            // احذف الـ tfvars والـ tfplan من الـ workspace عشان الأمان
            sh 'rm -f /tmp/db-result.json ${TF_DIR}/tfplan ${TF_DIR}/terraform.tfvars || true'
        }
        success {
            echo '🎉 Full Deploy completed successfully!'
        }
        failure {
            echo '❌ Deploy failed! Check logs above.'
        }
    }
}
